PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=hrga_request_db
JWT_SECRET=your_jwt_secret_key_here

# OTP Mailer Configuration
OTP_SMTP_HOST=smtp.gmail.com
OTP_SMTP_PORT=587
OTP_SMTP_USER=your_otp_email@gmail.com
OTP_SMTP_PASS=your_app_password
OTP_SMTP_FROM="HRGA Security OTP <your_otp_email@gmail.com>"

# HRGA Admin Notification Mailer
HRGA_SMTP_HOST=smtp.gmail.com
HRGA_SMTP_PORT=587
HRGA_SMTP_USER=your_hrga_email@gmail.com
HRGA_SMTP_PASS=your_app_password
HRGA_SMTP_FROM="HRGA Request System <your_hrga_email@gmail.com>"

# Admin Recipient Email
HRGA_ADMIN_RECIPIENT_EMAIL=your_hrga_email@gmail.com
